generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  userId              Int         @id @default(autoincrement())
  email               String      @unique
  password            String
  userName            String
  nickname            String      @unique
  createdAt           DateTime    @default(now())
  chatRooms           ChatRoom[]
  comments            Comments[]
  duoReviewsAsMyUser  DuoReview[] @relation("MyUserDuoReviews")
  duoReviewsAsSomeone DuoReview[] @relation("SomeoneUserDuoReviews")
  posts               Posts[]
  profiles            Profiles[]
}

model Posts {
  postId      Int        @id @default(autoincrement())
  profileId   Int
  title       String
  like        Int        @default(0)
  content     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  usersUserId Int?
  comments    Comments[]
  profile     Profiles   @relation(fields: [profileId], references: [profileId])
  Users       Users?     @relation(fields: [usersUserId], references: [userId])

  @@index([profileId], map: "Posts_profileId_fkey")
  @@index([usersUserId], map: "Posts_usersUserId_fkey")
}

model Profiles {
  profileId     Int        @id @default(autoincrement())
  userId        Int
  lolNickname   String
  tier          String
  line          String
  mostPlay      String
  averageRating Int        @default(0)
  ChatRoom      ChatRoom[]
  posts         Posts[]
  user          Users      @relation(fields: [userId], references: [userId])

  @@index([userId], map: "Profiles_userId_fkey")
}

model ChatRoom {
  chatRoomId Int      @id @default(autoincrement())
  userId     Int
  profileId  Int
  content    String
  createdAt  DateTime @default(now())
  profile    Profiles @relation(fields: [profileId], references: [profileId])
  user       Users    @relation(fields: [userId], references: [userId])

  @@index([profileId], map: "ChatRoom_profileId_fkey")
  @@index([userId], map: "ChatRoom_userId_fkey")
}

model DuoReview {
  duoReviewId   Int      @id @default(autoincrement())
  myUserId      Int
  someoneUserId Int
  content       String
  starRating    Int
  createdAt     DateTime @default(now())
  myUser        Users    @relation("MyUserDuoReviews", fields: [myUserId], references: [userId])
  someoneUser   Users    @relation("SomeoneUserDuoReviews", fields: [someoneUserId], references: [userId])

  @@index([myUserId], map: "DuoReview_myUserId_fkey")
  @@index([someoneUserId], map: "DuoReview_someoneUserId_fkey")
}

model Comments {
  commentId Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Posts    @relation(fields: [postId], references: [postId])
  user      Users    @relation(fields: [userId], references: [userId])

  @@index([postId], map: "Comments_postId_fkey")
  @@index([userId], map: "Comments_userId_fkey")
}

model Champions {
  chanpionId Int    @id @default(autoincrement())
  image      String
  name       String
}
