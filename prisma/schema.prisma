// Prisma 클라이언트 생성기를 설정합니다.
// Prisma 클라이언트 생성기를 설정합니다.
generator client {
    provider = "prisma-client-js"
}

// 데이터베이스 연결 설정
datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// 사용자 정보를 저장하는 테이블
model Users {
    userId              Int         @id @default(autoincrement())
    email               String      @unique
    password            String
    userName            String
    nickname            String      @unique
    createdAt           DateTime    @default(now())
    profiles            Profiles[] // 1:N 관계로 변경
    posts               Posts[]
    chatRooms           ChatRoom[]
    duoReviewsAsMyUser  DuoReview[] @relation("MyUserDuoReviews")
    duoReviewsAsSomeone DuoReview[] @relation("SomeoneUserDuoReviews")
    comments            Comments[]
    likes               Likes[]
    freeBoard           FreeBoard[]
}

model Posts {
    postId      Int        @id @default(autoincrement()) // Primary Key
    profileId   Int // Unique 제약 조건 제거
    title       String
    like        Int        @default(0) // 기본값 0
    content     String
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    profile     Profiles   @relation(fields: [profileId], references: [profileId]) // Foreign Key
    comments    Comments[] // 1:N 관계
    Users       Users?     @relation(fields: [usersUserId], references: [userId])
    usersUserId Int?
    likes       Likes[]
}

model Profiles {
    profileId     Int        @id @default(autoincrement())
    userId        Int // 외래키
    lolNickname   String
    tier          String
    line          String
    mostPlay      String
    averageRating Int        @default(0)
    user          Users      @relation(fields: [userId], references: [userId])
    posts         Posts[]
    ChatRoom      ChatRoom[]
}

model ChatRoom {
    chatRoomId Int      @id @default(autoincrement())
    userId     Int
    profileId  Int
    content    String
    createdAt  DateTime @default(now())
    user       Users    @relation(fields: [userId], references: [userId])
    profile    Profiles @relation(fields: [profileId], references: [profileId])
}

// 듀오 리뷰 정보를 저장하는 테이블
model DuoReview {
    duoReviewId   Int      @id @default(autoincrement())
    myUserId      Int
    someoneUserId Int
    content       String
    starRating    Int
    createdAt     DateTime @default(now()) // 변경
    myUser        Users    @relation("MyUserDuoReviews", fields: [myUserId], references: [userId])
    someoneUser   Users    @relation("SomeoneUserDuoReviews", fields: [someoneUserId], references: [userId])
}

// 댓글 정보를 저장하는 테이블y

// 댓글 정보를 저장하는 테이블
model Comments {
    commentId Int      @id @default(autoincrement())
    postId    Int
    userId    Int
    content   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    post      Posts    @relation(fields: [postId], references: [postId])
    user      Users    @relation(fields: [userId], references: [userId])
}

// 챔피언 정보를 저장하는 테이블
model Champions {
    championId Int    @id @default(autoincrement()) // 챔피언 ID, 자동 증가
    image      String @unique // 챔피언 이미지 URL, 고유 값
    name       String @unique // 챔피언 이름, 고유 값
}

// 좋아요 정보를 저장하는 테이블
model Likes {
    likeId Int    @id @default(autoincrement()) // 좋아요 ID, 자동 증가
    userId Int // 사용자 ID
    postId Int // 게시글 ID
    user   Users  @relation(fields: [userId], references: [userId]) // 사용자와의 관계
    post   Posts  @relation(fields: [postId], references: [postId]) // 게시글과의 관계

    @@unique([userId, postId]) // 사용자와 게시글 조합의 고유성 보장
}

// 자유 게시판 정보를 저장하는 테이블
model FreeBoard {
    freeBordId Int   @id @default(autoincrement()) // 자유 게시판 글 ID, 자동 증가
    userId     Int // 사용자 ID
    content    String // 글 내용
    createAt   DateTime @default(now()) // 생성 날짜
    user       Users    @relation(fields: [userId], references: [userId]) // 사용자와의 관계
}